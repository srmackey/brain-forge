primers/distill.md
primers/_system.md

# Personal context rather than vault knowledge. Same for any _<person>.md.
primers/_me.md

# Host / runtime
.obsidian/
.claude/
.grok/
.cursor/
.vscode/
.git/

# Chair overlay, if present
_status/
inbox/
PROTOCOL.md
_system/

